              "raw": "{\n  \"item_id\": {{itemId}},\n  \"storage_location_id\": 1,\n  \"event_type\": \"deposited\",\n  \"condition\": \"good\",\n  \"notes\": \"Item intake verified at Dessie Security Office counter.\"\n}"
