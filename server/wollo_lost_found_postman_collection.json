    {
      "name": "04. Claims & Verification",
      "item": [
        {
          "name": "List Claims",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims?status=pending&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["claims"],
              "query": [
                { "key": "status", "value": "pending" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Submit Claim on Found Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('claimId', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": {{itemId}},\n  \"explanation\": \"This is my brown wallet. It has my student ID card with ID WU/12345/16 and a photo on the inside sleeve.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims",
              "host": ["{{baseUrl}}"],
              "path": ["claims"]
            }
          }
        },
        {
          "name": "Get Claim Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}",
              "host": ["{{baseUrl}}"],
              "path": ["claims", "{{claimId}}"]
            }
          }
        },
        {
          "name": "Staff: Approve Claim (Auto-rejects competitors)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"review_note\": \"Claimant provided exact ID card number matching the item contents in Security Office custody.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["claims", "{{claimId}}", "review"]
            }
          }
        },
        {
          "name": "Staff: Reject Claim",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\",\n  \"review_note\": \"Claimant descriptions did not match item contents.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/review",
              "host": ["{{baseUrl}}"],
              "path": ["claims", "{{claimId}}", "review"]
            }
          }
        },
        {
          "name": "Admin: Reverse Claim Approval (Dispute Reversal)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"review_note\": \"Approval reversed upon investigation of disputed ownership. Reopening item for review.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/claims/{{claimId}}/reverse",
              "host": ["{{baseUrl}}"],
              "path": ["claims", "{{claimId}}", "reverse"]
            }
          }
        }
      ]
    },
