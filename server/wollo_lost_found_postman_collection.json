            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Abebe Bikila\",\n  \"university_id\": \"WU/12345/16\",\n  \"email\": \"student.wollo@wu.edu.et\",\n  \"password\": \"Student@Wollo2026!\",\n  \"password_confirmation\": \"Student@Wollo2026!\",\n  \"phone\": \"+251911223344\",\n  \"department_id\": 13\n}"
