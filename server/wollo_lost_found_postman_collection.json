    {
      "name": "03. Items Management",
      "item": [
        {
          "name": "List Authenticated User Items",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/items?type=lost&status=lost&per_page=20",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                { "key": "type", "value": "lost" },
                { "key": "status", "value": "lost" },
                { "key": "per_page", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Report Lost Item (Store Lost)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('itemId', jsonData.data.id);",
                  "    }",
                  "    if (jsonData.data && jsonData.data.reference_code) {",
                  "        pm.collectionVariables.set('referenceCode', jsonData.data.reference_code);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Black HP Laptop in Blue Bag\",\n  \"description\": \"HP Pavilion 15 with Intel Core i7 sticker left on the library 2nd floor desk.\",\n  \"category_id\": 1,\n  \"campus_id\": 1,\n  \"location_id\": 2,\n  \"location_detail\": \"Table #14 near the window\",\n  \"brand\": \"HP\",\n  \"color\": \"Black\",\n  \"serial_number\": \"CND7123XYZ\",\n  \"incident_date\": \"2026-08-16\",\n  \"incident_time\": \"14:30:00\",\n  \"estimated_value\": 45000.00,\n  \"is_high_value\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/items/lost",
              "host": ["{{baseUrl}}"],
              "path": ["items", "lost"]
            }
          }
        },
        {
          "name": "Report Found Item (Store Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set('itemId', jsonData.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
